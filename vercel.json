{
  "functions": {
    "api/booking.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/stripe/webhook.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/stripe/connect.ts": {
      "memory": 1024,
      "maxDuration": 20
    },
    "api/inspections/delete.ts": {
      "memory": 512,
      "maxDuration": 20
    },
    "api/inspections/replace.ts": {
      "memory": 512,
      "maxDuration": 20
    },
    "api/cron/renew-cautions.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/renew-cautions",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
