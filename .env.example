# ==============================================================================
# CONFIGURATION MATIK - EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# Port du serveur Express backend
PORT=3001

# URL de l'application (pour redirections Stripe success/cancel)
APP_URL="http://localhost:5173"

# Origines supplémentaires autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS="https://matikilou.com,https://www.matikilou.com"

# Configuration Supabase Auth & Database
VITE_SUPABASE_URL="https://inozsbkfcbkwlrozdvjj.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_Wk05Skx2hP-oq7BRKLXdSw_YnzHeLbe"

# URL Supabase côté serveur (API routes Vercel). Identique à VITE_SUPABASE_URL.
# Un repli est codé en dur dans les routes, mais expliciter évite toute ambiguïté.
SUPABASE_URL="https://inozsbkfcbkwlrozdvjj.supabase.co"

# ⚠️ OBLIGATOIRE (Lot 2) — clé service_role, uniquement côté serveur.
# Permet à l'API de recalculer les prix, d'enregistrer la réservation avant
# le paiement et de vérifier que l'appelant possède bien la réservation.
# Supabase Dashboard → Project Settings → API → `service_role` (secret).
# Ne JAMAIS l'exposer en VITE_* ni la committer.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Clé secrète Stripe (Gestion de la caution et empreinte bancaire)
# Obtenez votre clé sur : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# ⚠️ OBLIGATOIRE (Lot 2) — secret de signature du webhook Stripe.
# Stripe Dashboard → Developers → Webhooks → (endpoint) → Signing secret.
# Endpoint à déclarer : https://<domaine>/api/stripe/webhook
# Événements à écouter :
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   payment_intent.canceled
#   charge.dispute.created
#   charge.dispute.closed
#   account.updated
#   payout.failed
#   transfer.reversed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ⚠️ OBLIGATOIRE — secret du cron de renouvellement des cautions
# (Authorization: Bearer …). Sans lui, /api/cron/renew-cautions répond 503 :
# la route refuse d'être déclenchable publiquement.
CRON_SECRET="..."

# Clé API Resend (Envoi d'e-mails avec contrat PDF en pièce jointe)
# Obtenez votre clé sur : https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="Matik <noreply@matik.fr>"

# GEMINI_API_KEY: Optionnel pour fonctionnalités IA
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# MENTIONS LÉGALES (obligatoires — LCEN art. 6-III)
# ==============================================================================
# Tant qu'une valeur est absente, la page publique affiche « [à compléter : …] »
# et un bandeau d'avertissement. Aucune donnée n'est inventée automatiquement.
VITE_LEGAL_FORM="SAS"
VITE_LEGAL_CAPITAL="1 000 €"
VITE_LEGAL_SIRET="123 456 789 00012"
VITE_LEGAL_RCS="RCS Lyon 123 456 789"
VITE_LEGAL_VAT="FR12345678901"
VITE_LEGAL_ADDRESS="12 rue Exemple, 69000 Lyon"
VITE_LEGAL_PUBLICATION_DIRECTOR="Prénom Nom"
# Médiateur de la consommation (obligatoire pour la vente à distance aux particuliers)
VITE_LEGAL_MEDIATOR="CM2C — 14 rue Saint-Jean, 75017 Paris — cm2c.net"
